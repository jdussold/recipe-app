# Copy this file to .env and fill in real values for local development.
# .env is gitignored. Never commit secrets.

# Required in production. Locally, leave blank to use the dev fallback (only works when DJANGO_DEBUG=True).
DJANGO_SECRET_KEY=

# "True" enables debug mode + the dev SECRET_KEY fallback. Always "False" in production.
DJANGO_DEBUG=True

# Postgres connection URL. Leave blank locally to use SQLite (db.sqlite3).
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Cloudinary credentials for media uploads. Required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
